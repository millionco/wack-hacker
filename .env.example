# ─────────────────────────────────────────────────────────────────────────
# Pookie — Million's Slack bot. Copy to `.env.local` and fill in what you use.
# Only the "Core infrastructure" block is required; every integration below is
# optional — a domain's subagent refuses to launch when its keys are missing.
# ─────────────────────────────────────────────────────────────────────────

# ── Core infrastructure (required) ──
# Vercel cron/queue callbacks send `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=
# Scheduling DB (Turso / libsql)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Upstash Redis REST (approvals + task dedup)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Slack transport (Chat SDK + @chat-adapter/slack) ──
SLACK_BOT_TOKEN=
SLACK_BOT_NAME=
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Standard Redis (rediss://) URL backing the Chat SDK state adapter.
REDIS_URL=
# Public base URL for OAuth redirects + manifest endpoints.
BASE_URL=

# ── Engineering domains ──
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORG=
GITHUB_APP_INSTALLATION_ID=
LINEAR_API_KEY=
NOTION_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_DSN=
# Vercel (the `vercel` delegate operates on this team)
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# ── Money ──
STRIPE_API_KEY=
MERCURY_API_TOKEN=

# ── Analytics + observability ──
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=
AXIOM_API_TOKEN=
AXIOM_ORG_ID=

# ── Infra ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_SERVICE_TOKEN=
PLANETSCALE_ORG=

# ── Research ──
EXA_API_KEY=
REPOGREP_API_KEY=

# ── Coding sandbox (delegate_code) ──
# Optional: prebuilt sandbox snapshot id to skip ~20-30s of tool install.
SANDBOX_BASE_SNAPSHOT_ID=
