{
  "name": "@millionco/pookie",
  "version": "0.1.0",
  "private": true,
  "description": "Pookie — Million's AI-powered Slack bot. Coordinates specialized subagents to operate Slack, GitHub, Linear, Sentry, Vercel, Stripe, and more from Slack threads.",
  "keywords": [
    "ai",
    "ai-agent",
    "ai-sdk",
    "chat-sdk",
    "nextjs",
    "slack",
    "slack-bot",
    "vercel",
    "workflow-devkit"
  ],
  "homepage": "https://github.com/millionco/pookie#readme",
  "bugs": {
    "url": "https://github.com/millionco/pookie/issues"
  },
  "license": "MIT",
  "author": "Million",
  "contributors": [
    "Rayhan Noufal Arayilakath <me@rayhanadev.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millionco/pookie.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/compile-skills.ts && next build",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "validate": "bun run typecheck && bun run lint && bun run test",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.37",
    "@chat-adapter/slack": "^4.26.0",
    "@chat-adapter/state-redis": "^4.26.0",
    "@libsql/client": "^0.17.3",
    "@linear/sdk": "^82.1.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@notionhq/client": "^5.20.0",
    "@octokit/auth-app": "^8.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/api": "^0.113.0",
    "@sentry/nextjs": "^10.50.0",
    "@slack/web-api": "^7.15.1",
    "@t3-oss/env-core": "^0.13.11",
    "@upstash/redis": "^1.37.0",
    "@vercel/functions": "^3.4.4",
    "@vercel/queue": "^0.1.6",
    "@vercel/sandbox": "^1.10.0",
    "@vercel/sdk": "^1.19.40",
    "ai": "^6.0.168",
    "chat": "^4.26.0",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.13.0",
    "exa-js": "^1.4.4",
    "hono": "^4.12.14",
    "next": "^16.2.4",
    "octokit": "^5.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ulid": "^3.0.2",
    "workflow": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@factory/eslint-plugin": "^0.1.0",
    "@types/bun": "1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260423.1",
    "@vercel/config": "^0.2.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "oxclippy": "^0.2.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{json,jsonc}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": "^1.3.10"
  },
  "packageManager": "bun@1.3.13"
}
